{
  "name": "aof-akilli-calisma-kocu",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "description": "AÖF Bilgisayar Programcılığı 1. Sınıf Güz Dönemi Akıllı Çalışma Koçu",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "desktop:icon": "node scripts/generate-icon.mjs",
    "desktop:prepare": "npm run build && node scripts/prepare-standalone.mjs",
    "desktop": "npm run desktop:prepare && electron .",
    "desktop:app": "node scripts/launch-app.mjs",
    "desktop:dev": "electron . --dev",
    "desktop:build": "npm run desktop:prepare && electron-builder --win --publish never",
    "release:zip": "npm run desktop:prepare && node scripts/package-release.mjs"
  },
  "build": {
    "appId": "com.aof.akillicalismakocu",
    "productName": "AOF Akilli Calisma Kocu",
    "asar": true,
    "afterPack": "./scripts/after-pack.cjs",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "AOF-Akilli-Calisma-Kocu-Kurulum.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AÖF Akıllı Çalışma Koçu",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "AOF-Akilli-Calisma-Kocu-Portable.exe"
    }
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^2.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
