# İstediğiniz herhangi bir AI sağlayıcısının API anahtarını ekleyebilirsiniz
# (veya uygulamayı açtıktan sonra doğrudan "API & AI Ayarları" penceresinden girebilirsiniz).

# 1) Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 2) OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=

# 3) Anthropic Claude (https://console.anthropic.com/settings/keys)
# ANTHROPIC_API_KEY=

# 4) Groq - Ücretsiz / Hızlı (https://console.groq.com/keys)
# GROQ_API_KEY=

# 5) OpenRouter / DeepSeek / xAI Grok / Mistral / Together
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=

# 6) EVREN LLM (https://evren.ssyz.org.tr)
# EVREN_API_KEY=
# EVREN_MODEL=deepseek-v4.1-flash

# 7) Özel OpenAI-Uyumlu URL veya Yerel Ollama
# CUSTOM_AI_PROVIDER=ollama
# CUSTOM_AI_BASE_URL=http://127.0.0.1:11434/v1
# CUSTOM_AI_MODEL=llama3.1
# CUSTOM_AI_API_KEY=
# AI_PROVIDER=auto
